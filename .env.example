# =====================================================================
# DigiBuzz AI Calling Agent - Environment Configuration
# =====================================================================

# Primary Google Gemini API Key (Required)
# Generate a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Secondary Google Gemini API Key (Optional — enables automatic quota failover)
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# Gemini Model Identifier
# Recommended models:
# - models/gemini-flash-lite-latest   (Fastest response, ideal for live voice calling)
# - models/gemini-1.5-flash
# - gemini-2.0-flash
GEMINI_MODEL=models/gemini-flash-lite-latest

# Application Server Port (Optional, default is 8000)
PORT=8000
