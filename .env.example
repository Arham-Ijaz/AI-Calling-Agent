# =====================================================================
# AI Customer Calling Agent - Production Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 0. MongoDB Atlas Database Configuration (Vercel Serverless Ready)
# ---------------------------------------------------------------------
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
# Optional MongoDB database name (default: ai_calling_db)
MONGODB_DB_NAME=ai_calling_db

# ---------------------------------------------------------------------
# 1. Google Gemini AI Models & Dual Failover API Keys
# ---------------------------------------------------------------------
# Primary Google Gemini API Key (Required)
# Generate a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Secondary Google Gemini API Key (Optional — enables automatic quota failover)
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# Gemini Model Identifier
# Recommended fast models for real-time voice calls:
# - models/gemini-flash-lite-latest   (Fastest inference speed, ideal for voice)
# - models/gemini-1.5-flash
# - gemini-2.0-flash
GEMINI_MODEL=models/gemini-flash-lite-latest

# Application Server Port (Default: 8000)
PORT=8000

# ---------------------------------------------------------------------
# 2. Telephony API Integration (Twilio / SIP / PSTN Inbound & Outbound)
# ---------------------------------------------------------------------
# Telephony provider ('twilio', 'telnyx', 'vonage', 'livekit')
TELEPHONY_PROVIDER=twilio

# Twilio Account SID & Auth Token (Get from: https://console.twilio.com/)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Telephony Caller ID / Virtual Phone Number (E.164 format, e.g. +12345678901)
TWILIO_PHONE_NUMBER=+12345678901

# Public Webhook Domain for Telephony Callbacks (ngrok / Cloudflare Tunnel / Public IP)
# E.g.: https://your-domain.ngrok-free.app
TELEPHONY_WEBHOOK_URL=https://your-public-domain.ngrok-free.app

# Telephony Voice Synthesizer & Speech Recognition Language
TELEPHONY_DEFAULT_VOICE=Polly.Aditi
TELEPHONY_LANGUAGE=en-US

# ---------------------------------------------------------------------
# 3. Security, Authentication & Session Configuration
# ---------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens
JWT_SECRET=super_secure_random_jwt_secret_key_change_in_production_2026

# Primary Administrator Credentials (Auto-created on first database boot)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPass123!

# Free Guest Call Turn Limit (Number of free turns allowed before requiring sign-up)
GUEST_CALL_LIMIT=5

# ---------------------------------------------------------------------
# 4. Text-To-Speech (TTS) Voice Settings
# ---------------------------------------------------------------------
# Edge-TTS Neural Voices for Real-Time Streaming
DEFAULT_ENGLISH_VOICE=en-US-AriaNeural
DEFAULT_URDU_VOICE=ur-PK-UzmaNeural
